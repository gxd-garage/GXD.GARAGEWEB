// Configuración de Cloudflare para publicar el sitio.
// Cloudflare ejecuta "node build.mjs", que genera el sitio en la carpeta dist,
// y luego publica esa carpeta. worker/index.js solo redirige www y la dirección
// antigua de workers.dev hacia https://gxdgarage.cl.
{
  "name": "gxd-garageweb",
  "main": "worker/index.js",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}
